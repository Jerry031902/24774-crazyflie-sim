+        cmd,base=command(root,seed,mode,case)
+        if not base.with_suffix(".json").exists():
+            if base.with_suffix(".csv").exists():raise RuntimeError(f"Partial run requires review: {base}")
+            base.parent.mkdir(parents=True,exist_ok=True)
